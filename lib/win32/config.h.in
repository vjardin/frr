#ifndef _FRR_WIN32_CONFIG_H
#define _FRR_WIN32_CONFIG_H

#define PACKAGE "frr"
#define PACKAGE_NAME "frr"
#define PACKAGE_TARNAME "frr"
#define PACKAGE_VERSION "@FRR_VERSION@"
#define PACKAGE_STRING "frr @FRR_VERSION@"
#define PACKAGE_BUGREPORT "https://github.com/frrouting/frr/issues"
#define PACKAGE_URL "https://frrouting.org/"
#define VERSION "@FRR_VERSION@"
#define CONFDATE @FRR_CONFDATE@

#define DFLT_NAME "traditional"
#define MULTIPATH_NUM 16
#define CONFIGFILE_MASK 0600
#define LOGFILE_MASK 0600
#define LOG_TIMESTAMP_PRECISION 0
#define VTYSH_PAGER "more"
#define DISABLE_BGP_ANNOUNCE 0
#define CRYPTO_INTERNAL 1

/* Windows has no ELF, so no xref ELF note */
#define FRR_XREF_NO_NOTE 1

/* regex.h comes from PCRE2's POSIX wrapper */
#define HAVE_LIBPCRE2_POSIX 1

/* no symbol aliases with MSVC: keep the system inet_ntop() */
#define INET_NTOP_NO_OVERRIDE 1

#define HAVE_STRUCT_SOCKADDR_IN6_SIN6_SCOPE_ID 1

/* struct ip_mreq with the interface index in imr_interface (0.0.0.x) is
 * what Windows supports for IPv4 multicast membership
 */
#define HAVE_BSD_STRUCT_IP_MREQ_HACK 1

/* list of supported daemon */
#define HAVE_BGPD 1
#define HAVE_RIPD 1
#define HAVE_RIPNGD 1
#define HAVE_OSPFD 1
#define HAVE_OSPF6D 1
#define HAVE_STATICD 1
#define HAVE_EIGRPD 1
#define HAVE_BABELD 1
#define HAVE_SHARPD 1

#define HAVE_BFDD 1
#define BFD_BSD 1

/* ospfd -a: the OSPF API server, for clients of the LSA database */
#define SUPPORT_OSPF_API 1

#cmakedefine HAVE_ISISD 1
#cmakedefine HAVE_FABRICD 1
#define ISIS_METHOD_PFPACKET 1
#define ISIS_METHOD_DLPI 2
#define ISIS_METHOD_BPF 3
#define ISIS_METHOD_NPCAP 4
#define ISIS_METHOD ISIS_METHOD_NPCAP

/* daemons listen for vtysh on an AF_UNIX socket (Windows 10 1803+) */
#define VTYSH 1
#define HAVE_CLOCK_MONOTONIC 1
#define HAVE_PTHREAD_SETNAME_NP 1
#define HAVE_PTHREAD_GETTHREADID_NP 1

/* readline (vtysh) */
#define HAVE_APPEND_HISTORY 1

#define HAVE_MALLOC_USABLE_SIZE 1
#define malloc_usable_size(p) _msize(p)

@FRR_WIN32_EXTRA_DEFINES@

#endif /* _FRR_WIN32_CONFIG_H */
